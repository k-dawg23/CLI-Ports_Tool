{
  "name": "ports",
  "version": "2.0.1",
  "description": "Developer-friendly CLI and TUI for inspecting listening ports.",
  "type": "module",
  "bin": {
    "ports": "./dist/cli.js"
  },
  "files": [
    "dist",
    "index.html",
    "PROJECT_HISTORY.md",
    "README.md",
    "USER_MANUAL.md"
  ],
  "scripts": {
    "build": "tsup src/cli.tsx --format esm --dts --clean",
    "dev": "tsx src/cli.tsx",
    "start": "node dist/cli.js",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "test:integration": "node scripts/test.mjs --integration",
    "test:native": "node --import tsx scripts/native-smoke.mjs"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "keywords": [
    "cli",
    "ports",
    "tui",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "execa": "^9.5.2",
    "ink": "^5.2.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}

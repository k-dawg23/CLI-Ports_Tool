@@ -0,0 +1,94 @@
+import assert from 'node:assert/strict';
+import fs from 'node:fs/promises';
+import path from 'node:path';
+import os from 'node:os';
+import { spawn } from 'node:child_process';
+import { once } from 'node:events';
+import { createInterface } from 'node:readline';
+import { fileURLToPath } from 'node:url';
+import { setTimeout as delay } from 'node:timers/promises';
+import { StringDecoder } from 'node:string_decoder';
+
+const here = path.dirname(fileURLToPath(import.meta.url));
+const directory = process.env.PORTS_PTY_OUTPUT_DIR;
+assert.ok(directory, 'A fresh explicit evidence directory is required');
+await fs.mkdir(directory, { recursive: true });
+const report = { stage1: 'NOT ATTEMPTED', stage2: 'NOT ATTEMPTED', sha: process.env.GITHUB_SHA, run: process.env.GITHUB_RUN_ID, attempt: process.env.GITHUB_RUN_ATTEMPT, platform: process.platform, os: os.release(), node: process.version, dimensions: { columns: 160, rows: 60 }, sessions: [] };
+const live = [];
+async function session(name, args, env = {}) {
+  const command = ['python3', path.join(here, 'host.py'), process.execPath, '--require', path.join(here, 'lifetime.cjs'), ...args];
+  const child = spawn(command[0], command.slice(1), { env: { ...process.env, ...env }, stdio: ['pipe', 'pipe', 'pipe'] });
+  const closed = once(child, 'close');
+  live.push({ child, closed });
+  const data = { name, command, events: [], input: [], output: '', stderr: '' };
+  report.sessions.push(data);
+  const decoder = new StringDecoder('utf8');
+  child.stderr.on('data', chunk => { data.stderr += chunk; });
+  createInterface({ input: child.stdout }).on('line', line => {
+    try {
+      const event = JSON.parse(line); data.events.push(event);
+      if (event.type === 'output') data.output += decoder.write(Buffer.from(event.data, 'base64'));
+    } catch (error) { data.events.push({ type: 'protocol-error', line, error: error.message }); }
+  });
+  child.stdin.on('error', () => {}); // A failed host may already have closed input.
+  const input = text => {
+    data.input.push({ at: Date.now(), text });
+    child.stdin.write(JSON.stringify({ type: 'input', data: Buffer.from(text).toString('base64') }) + '\n');
+  };
+  const wait = async (label, predicate, ms = 30000) => {
+    console.log(`PTY waiting: ${label}`);
+    const deadline = Date.now() + ms;
+    while (!(await predicate())) {
+      assert.ok(Date.now() < deadline, `Timed out: ${name}: ${label}`);
+      assert.ok(!data.events.some(e => /error/.test(e.type)), JSON.stringify(data));
+      assert.equal(child.exitCode, null, JSON.stringify(data));
+      await delay(50);
+    }
+    console.log(`PTY observed: ${label}`);
+  };
+  const finish = async (failure = false) => {
+    const [code, signal] = await closed; data.hostExit = { code, signal };
+    if (failure) assert.notEqual(code, 0); else assert.equal(code, 0, JSON.stringify(data));
+    const cleanup = data.events.find(e => e.type === 'cleanup');
+    assert.ok(cleanup?.descriptorsClosed && cleanup.childReaped, JSON.stringify(data));
+    if (!failure) assert.ok(cleanup.normalExit && cleanup.outputDrained && cleanup.terminalRestoredByChild !== false, JSON.stringify(data));
+    child.stdin.end();
+  };
+  return { data, input, wait, finish, abort: () => child.stdin.write('{"type":"abort"}\n'), disconnect: () => child.stdin.end() };
+}
+try {
+  assert.ok(['linux', 'darwin'].includes(process.platform));
+  report.stage1 = 'FAIL';
+  const probe = await session('feasibility', [path.join(here, 'keyboard-probe.cjs')]);
+  await probe.wait('raw-ready', () => probe.data.output.includes('raw-ready'));
+  assert.match(probe.data.output, /"stdinTTY":true,"stdoutTTY":true,"rawAvailable":true/);
+  assert.match(probe.data.output, /"columns":160,"rows":60/);
+  const native = probe.data.events.find(e => e.type === 'pty');
+  assert.equal(native.sessionId, native.pid);
+  assert.match(probe.data.output, new RegExp(`"foregroundGroup": ${native.pid}, "pid": ${native.pid}`));
+  for (const [text, name] of [['a', 'a'], ['\x1b[A', 'up'], ['b', 'b'], ['q', 'q']]) {
+    probe.input(text); await probe.wait(`key ${name}`, () => probe.data.output.includes(`"name":"${name}"`));
+  }
+  await probe.finish();
+  assert.match(probe.data.output, /"marker":"probe-complete","raw":false/);
+  for (const method of ['abort', 'disconnect']) {
+    const failure = await session(`failure-${method}`, [path.join(here, 'keyboard-probe.cjs')]);
+    await failure.wait('raw-ready', () => failure.data.output.includes('raw-ready'));
+    failure[method](); await failure.finish(true);
+  }
+  report.stage1 = 'PASS';
+  console.log('Stage 1 PASS: actual Unix PTY, TTY/raw input, keyboard, output, dimensions, normal exit and abort/disconnect cleanup');
+  if (process.argv.includes('--cli')) {
+    const { verifyCli } = await import('./cli-stage.mjs');
+    await verifyCli({ session, report, directory, here });
+  }
+} catch (error) {
+  report.error = error.stack; console.error(error); process.exitCode = 1;
+} finally {
+  for (const { child, closed } of live) {
+    if (child.exitCode === null && !child.stdin.destroyed) child.stdin.end();
+    await closed.catch(error => { report.cleanupError = error.message; });
+  }
+  for (const data of report.sessions) await fs.writeFile(path.join(directory, `${data.name}-terminal.txt`), data.output);
+  await fs.writeFile(path.join(directory, 'experiment.json'), JSON.stringify(report, null, 2) + '\n');
+}
diff --git a/scripts/unix-pty/host.py b/scripts/unix-pty/host.py
new file mode 100644
index 0000000..11c0c6f
--- /dev/null
+++ b/scripts/unix-pty/host.py
@@ -0,0 +1,142 @@
+"""Test-only, single-threaded Unix PTY host; no numeric-PID signalling.
+
+The child owns a new session/controlling terminal. Closing our master causes
+kernel terminal hangup in that session only. A private pipe also makes the
+test-only Node lifetime preload exit itself on abort or host disappearance.
+"""
+import base64
+import errno
+import fcntl
+import json
+import os
+import platform
+import pty
+import select
+import struct
+import subprocess
+import sys
+import termios
+import time
+
+
+def emit(**value):
+    print(json.dumps(value), flush=True)
+
+
+master, slave = pty.openpty()
+control_read, control_write = os.pipe()
+original = termios.tcgetattr(slave)
+fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack('HHHH', 60, 160, 0, 0))
+child = None
+normal = False
+drained = False
+result = 1
+
+
+def attach_terminal():
+    # Popen performs setsid() before this preexec callback. This isolated Python
+    # helper has no threads, networking or macOS higher-level framework imports.
+    fcntl.ioctl(0, termios.TIOCSCTTY, 0)
+    os.write(1, (json.dumps(dict(marker='controlling-terminal', foregroundGroup=os.tcgetpgrp(0), pid=os.getpid())) + '\n').encode())
+
+
+try:
+    env = dict(os.environ, PORTS_PTY_CONTROL_FD=str(control_read))
+    child = subprocess.Popen(sys.argv[1:], stdin=slave, stdout=slave, stderr=slave,
+                             start_new_session=True, preexec_fn=attach_terminal,
+                             pass_fds=(control_read,), env=env)
+    os.close(control_read)
+    control_read = -1
+    emit(type='pty', api='pty.openpty + setsid + TIOCSCTTY', pid=child.pid,
+         command=sys.argv[1:], python=sys.version, os=platform.platform(),
+         columns=160, rows=60, slave=os.ttyname(slave),
+         sessionId=os.getsid(child.pid))
+    os.set_blocking(master, False)
+    buffer = b''
+    deadline = time.monotonic() + 240
+    while True:
+        if time.monotonic() > deadline:
+            raise TimeoutError('Owned terminal session deadline exceeded')
+        ready, _, _ = select.select([master, sys.stdin.buffer], [], [], 0.1)
+        if master in ready:
+            try:
+                data = os.read(master, 16384)
+                if data:
+                    emit(type='output', data=base64.b64encode(data).decode('ascii'))
+                else:
+                    drained = True
+            except OSError as error:
+                if error.errno != errno.EIO:
+                    raise
+                drained = True  # Linux PTY EOF; macOS may return zero bytes.
+        if sys.stdin.buffer in ready:
+            data = os.read(sys.stdin.fileno(), 4096)
+            if not data:
+                raise RuntimeError('Controller disconnected')
+            buffer += data
+            while b'\n' in buffer:
+                line, buffer = buffer.split(b'\n', 1)
+                event = json.loads(line)
+                if event['type'] == 'abort':
+                    raise RuntimeError('Requested owned-session abort')
+                payload = base64.b64decode(event['data'])
+                while payload:
+                    written = os.write(master, payload)
+                    payload = payload[written:]
+        # poll() reaps only our direct child; no PID lookups or signal fallback.
+        if child.poll() is not None:
+            # Drain remaining output after child exit, while retaining slave to
+            # inspect actual terminal settings (therefore EOF is not required).
+            while select.select([master], [], [], 0)[0]:
+                try:
+                    data = os.read(master, 16384)
+                except OSError as error:
+                    if error.errno != errno.EIO:
+                        raise
+                    break
+                if not data:
+                    break
+                emit(type='output', data=base64.b64encode(data).decode('ascii'))
+            drained = True
+            normal = child.returncode == 0
+            result = 0 if normal else 1
+            emit(type='exit', exitCode=child.returncode)
+            break
+except Exception as error:
+    emit(type='error', error=repr(error))
+finally:
+    restored = False
+    inspection = 'not-inspected-abnormal-exit'
+    if child is not None and child.poll() is not None:
+        try:
+            current = termios.tcgetattr(slave)
+            mask = termios.ECHO | termios.ICANON
+            restored = current[3] & mask == original[3] & mask
+            inspection = 'post-exit-termios-comparison'
+        except termios.error as error:
+            # macOS invalidates terminal ioctls when the session leader exits.
+            # Preserve the explicit limitation; Node raw-state evidence is
+            # checked separately, and teardown must still close every fd.
+            restored = None
+            inspection = 'unavailable-after-exit: ' + repr(error)
+            if error.args[0] not in (errno.ENOTTY, errno.EIO):
+                result = 1
+    # Terminal hangup targets only the session created above; EOF on this pipe
+    # also reaches only the child with its explicitly inherited private fd.
+    os.close(master)
+    os.close(control_write)
+    if control_read >= 0:
+        os.close(control_read)
+    if child is not None:
+        try:
+            child.wait(timeout=15)
+        except subprocess.TimeoutExpired:
+            emit(type='cleanup-error', error='Owned child did not exit on terminal/control closure; no unsafe signal fallback')
+            result = 1
+    # A hung-up slave may reject termios calls. It is about to be closed; normal
+    # restoration was inspected before hangup, rather than fabricated by host.
+    os.close(slave)
+    emit(type='cleanup', descriptorsClosed=True, childReaped=child is not None and child.returncode is not None,
+         exitCode=None if child is None else child.returncode, normalExit=normal,
+         outputDrained=drained, terminalRestoredByChild=restored, termiosInspection=inspection)
+sys.exit(result)
